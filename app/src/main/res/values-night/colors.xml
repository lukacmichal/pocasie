<?xml version="1.0" encoding="utf-8"?>
<!--
  Čierny (nočný) režim. Mená sú tie isté ako vo `values/colors.xml`.

  Pozadie je ČISTÁ čierna #000000, nie tmavosivá — celý zmysel režimu je výdrž
  batérie na OLED displeji. Karty a polia sú len o kúsok nad čiernou, aby bolo
  vidieť ich hranicu.

  Teplá a studená farba sú svetlejšie odtiene než v dennom režime; tie denné sú
  na čiernom pozadí tmavé a splývajú.
-->
<resources>
    <color name="pozadie">#000000</color>
    <color name="text_hlavny">#E5E7EB</color>
    <color name="text_vedlajsi">#9CA3AF</color>
    <color name="rast">#4ADE80</color>
    <color name="pokles">#F87171</color>
    <color name="chyba">#F87171</color>

    <color name="teplo">#FB923C</color>
    <color name="zima">#60A5FA</color>
    <color name="zrazky">#22D3EE</color>

    <color name="widget_pozadie">#000000</color>
    <color name="widget_ciara">#2A2A2A</color>

    <color name="ikona">#9CA3AF</color>

    <color name="pole_pozadie">#0E0E0E</color>
    <color name="ciara">#262626</color>

    <color name="ver_text">#9CA3AF</color>
    <color name="ver_warn">#FBBF24</color>
</resources>
