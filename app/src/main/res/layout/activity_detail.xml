<?xml version="1.0" encoding="utf-8"?>
<!--
  Detail miesta: hore po hodinach (vodorovne rolovanie), pod tym po dnoch.

  Hodiny su vodorovne a dni zvisle zamerne: hodin je 168 a zvislo by z toho bol
  zoznam, ktorym sa neda prejst; dni je sedem a tie sa citaju naraz.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pozadie"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/btn_spat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_spat"
            android:contentDescription="@string/n_spat"
            android:background="?android:selectableItemBackgroundBorderless"
            app:tint="@color/ikona" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/detail_nazov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/text_hlavny" />

            <TextView
                android:id="@+id/detail_stav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="12sp"
                android:textColor="@color/text_vedlajsi" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ciara" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              Graf pocasia: stlpce zrazok a ciara teploty. Je HORE, nad pasikom
              hodin: otazka "ako bude a ci brat dazdnik" je jediny dovod, preco
              sa clovek do detailu pozera, a odpoved na nu nema byt az pod
              ohybom. Pod nadpisom je vyber rozsahu (24 h az 7 dni).
            -->
            <TextView
                android:id="@+id/nadpis_graf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:text="@string/graf_nadpis_hodiny"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_vedlajsi" />

            <!-- Vodorovne rolovanie, nie zalamovanie: sedem tlacidiel sa na
                 uzkom telefone do riadku nezmesti a zalomeny rad by posunul
                 graf mimo obrazovku. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/graf_rozsahy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/graf_stav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_vedlajsi" />

            <sk.lukac.pocasie.GrafView
                android:id="@+id/graf_pocasie"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginHorizontal="14dp" />

            <TextView
                android:id="@+id/nadpis_hodiny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="@string/detail_hodiny"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_vedlajsi" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/zoznam_hodin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:text="@string/detail_dni"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_vedlajsi" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/zoznam_dni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Faza mesiaca. Pod zoznamom dni zamerne: je to jeden udaj na cely
                 tyzden, nie stlpec v tabulke, a hore by tlacil vsetko ostatne
                 nizsie. -->
            <TextView
                android:id="@+id/detail_mesiac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:textSize="13sp"
                android:textColor="@color/text_vedlajsi"
                tools:text="🌔 dorastajúci mesiac · spln 8. 9." />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
